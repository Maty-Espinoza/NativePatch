+++ b/Core/HLE/Adrenaline.cpp
@@ -0,0 +1,194 @@
+// Modelo de Adrenaline: ver Adrenaline.h
+#include <cstdlib>
+#include <cstring>
+#include <set>
+
+#include "Common/File/FileUtil.h"
+#include "Common/File/Path.h"
+#include "Common/Log.h"
+#include "Common/StringUtils.h"
+#include "Core/Config.h"
+#include "Core/Core.h"
+#include "Core/MemMap.h"
+#include "Core/MIPS/MIPS.h"
+#include "Core/HLE/HLE.h"
+#include "Core/HLE/sceKernelMemory.h"
+#include "Core/HLE/Adrenaline.h"
+
+namespace Adrenaline {
+
+enum : u32 {
+	DRAW_NATIVE = 0x0BCDEF00,        // 0xABCDEF00 sin el segmento
+	NATIVE_FRAMEBUFFER = 0x0A400000,
+	NATIVE_W = 960, NATIVE_H = 544,
+	STUB_BLOCK = 0x800,              // 256 stubs de 8 bytes
+};
+
+struct Stub { std::string lib; u32 nid; u32 addr; };
+struct Override { const HLEFunction *func; u32 target; };
+
+static int mode = -1;  // 0 apagado, 1 activo, 2 estricto
+static std::vector<Stub> stubs;
+static std::vector<Override> overrides;
+static std::set<std::string> warned;
+static u32 stubBlock, stubUsed, fileNameAddr;
+static std::string initFileName;
+
+static int Mode() {
+	if (mode < 0) {
+		const char *e = getenv("PPSSPP_ADRENALINE");
+		mode = !e || !*e || !strcmp(e, "0") ? 0 : !strcmp(e, "estricto") ? 2 : 1;
+	}
+	return mode;
+}
+
+bool Enabled() { return Mode() != 0; }
+
+void Reset() {
+	stubs.clear();
+	overrides.clear();
+	warned.clear();
+	stubBlock = stubUsed = fileNameAddr = 0;  // la memoria de kernel se reinicia con el juego
+}
+
+std::vector<std::string> GamePlugins() {
+	std::vector<std::string> out;
+	std::string text;
+	if (!File::ReadTextFileToString(g_Config.memStickDirectory / "seplugins" / "game.txt", &text))
+		return out;
+	std::vector<std::string> lines;
+	SplitString(text, '\n', lines, true);
+	for (const std::string &line : lines) {
+		size_t sp = line.find_last_of(" \t");
+		if (line.empty() || line[0] == '#' || sp == std::string::npos || StripSpaces(line.substr(sp)) != "1")
+			continue;
+		std::string path(StripSpaces(line.substr(0, sp)));
+		// En la Vita las rutas pueden ir por ux0:/pspemu/, que para el PSP es ms0:/
+		if (startsWithNoCase(path, "ux0:/pspemu/"))
+			path = "ms0:/" + path.substr(12);
+		out.push_back(path);
+	}
+	return out;
+}
+
+uint32_t HleStub(const char *library, uint32_t nid) {
+	if (!library || !GetHLEFunc(library, nid))
+		return 0;
+	for (const Stub &s : stubs)
+		if (s.nid == nid && s.lib == library)
+			return s.addr;
+	if (!stubBlock || stubUsed + 8 > STUB_BLOCK) {
+		u32 size = STUB_BLOCK;
+		u32 addr = kernelMemory.Alloc(size, true, "Adrenaline stubs");
+		if (addr == (u32)-1)
+			return 0;
+		stubBlock = addr;
+		stubUsed = 0;
+	}
+	u32 addr = stubBlock + stubUsed;
+	stubUsed += 8;
+	WriteHLESyscall(library, nid, addr);
+	currentMIPS->InvalidateICacheRangeDeferred(addr, 8);
+	stubs.push_back({library, nid, addr});
+	return addr;
+}
+
+bool StubOf(uint32_t addr, std::string *library, uint32_t *nid) {
+	for (const Stub &s : stubs) {
+		if ((s.addr & 0x1FFFFFFF) == (addr & 0x1FFFFFFF)) {
+			*library = s.lib;
+			*nid = s.nid;
+			return true;
+		}
+	}
+	return false;
+}
+
+// La misma funcion del sistema puede exportarse en varias bibliotecas (sceGe_user/sceGe_driver,
+// sceCtrl/sceCtrl_driver): el CFW parcha la entrada de la tabla de syscalls, que es una sola
+void AddOverride(const char *library, uint32_t nid, uint32_t target) {
+	const HLEFunction *f = GetHLEFunc(library, nid);
+	if (!f)
+		return;
+	for (Override &o : overrides) {
+		if (o.func->func == f->func && o.func->ID == f->ID) {
+			o.target = target;
+			return;
+		}
+	}
+	overrides.push_back({f, target});
+}
+
+uint32_t ImportOverride(const char *library, uint32_t nid) {
+	if (overrides.empty())
+		return 0;
+	const HLEFunction *f = GetHLEFunc(library, nid);
+	if (!f)
+		return 0;
+	for (const Override &o : overrides)
+		if (o.func->func == f->func && o.func->ID == f->ID)
+			return o.target;
+	return 0;
+}
+
+void SetInitFileName(const std::string &filename) {
+	initFileName = filename;
+	fileNameAddr = 0;
+}
+
+uint32_t InitFileNameAddr() {
+	if (!fileNameAddr && !initFileName.empty()) {
+		u32 size = (u32)initFileName.size() + 1;
+		u32 addr = kernelMemory.Alloc(size, true, "InitFileName");
+		if (addr == (u32)-1)
+			return 0;
+		Memory::MemcpyUnchecked(addr, initFileName.c_str(), (u32)initFileName.size() + 1);
+		fileNameAddr = addr;
+	}
+	return fileNameAddr;
+}
+
+bool NativeActive() {
+	return Enabled() && Memory::IsValid4AlignedAddress(DRAW_NATIVE) && Memory::ReadUnchecked_U32(DRAW_NATIVE) != 0;
+}
+
+uint32_t NativeAddress() { return NATIVE_FRAMEBUFFER; }
+
+// BMP de 24 bits de 960x544 desde la imagen nativa (565)
+bool SaveNative(const Path &bmp) {
+	if (!Memory::IsValidRange(NATIVE_FRAMEBUFFER, NATIVE_W * NATIVE_H * 2))
+		return false;
+	FILE *f = File::OpenCFile(bmp, "wb");
+	if (!f)
+		return false;
+	const u32 row = NATIVE_W * 3, data = row * NATIVE_H;
+	u8 hdr[54] = {'B', 'M'};
+	auto put32 = [&](int at, u32 v) { for (int i = 0; i < 4; i++) hdr[at + i] = (u8)(v >> (i * 8)); };
+	put32(2, 54 + data); put32(10, 54); put32(14, 40); put32(18, NATIVE_W); put32(22, NATIVE_H);
+	hdr[26] = 1; hdr[28] = 24; put32(34, data);
+	fwrite(hdr, 1, sizeof(hdr), f);
+	std::vector<u8> line(row);
+	const u16_le *src = (const u16_le *)Memory::GetPointerUnchecked(NATIVE_FRAMEBUFFER);
+	for (int y = NATIVE_H - 1; y >= 0; y--) {
+		for (int x = 0; x < NATIVE_W; x++) {
+			u16 c = src[y * NATIVE_W + x];
+			u8 r = c & 31, g = (c >> 5) & 63, b = c >> 11;
+			line[x * 3] = (b << 3) | (b >> 2);
+			line[x * 3 + 1] = (g << 2) | (g >> 4);
+			line[x * 3 + 2] = (r << 3) | (r >> 2);
+		}
+		fwrite(line.data(), 1, row, f);
+	}
+	fclose(f);
+	return true;
+}
+
+void Warn(const char *what) {
+	if (!Enabled() || !warned.insert(what).second)
+		return;
+	ERROR_LOG(Log::HLE, "Adrenaline: %s (en la Vita esto congela o cierra Adrenaline) pc=%08x ra=%08x", what, currentMIPS->pc, currentMIPS->r[MIPS_REG_RA]);
+	if (Mode() == 2)
+		Core_Stop();
+}
+
+}  // namespace Adrenaline
diff --git a/Core/HLE/Adrenaline.h b/Core/HLE/Adrenaline.h
new file mode 100644
index 0000000..a57430c
--- /dev/null
+++ b/Core/HLE/Adrenaline.h
@@ -0,0 +1,49 @@
+// Modelo de Adrenaline (PSP dentro de la PS Vita) para probar plugins como GePatch tal cual,
+// cargados desde su .prx. Se activa con la variable de entorno PPSSPP_ADRENALINE=1. Lo que imita:
+//  - plugins de ms0:/seplugins/game.txt ("ruta 1" por linea), cargados con el juego
+//  - 64 MB de RAM con la particion de usuario de 32 MB (0x0A000000+ libre para el plugin)
+//  - SystemCtrlForKernel: sctrlHENFindFunction tambien encuentra funciones del sistema (HLE) y
+//    sctrlHENPatchSyscall redirige las llamadas de los modulos de usuario a otra funcion
+//  - VRAM de 2 MB: sceGeEdramSetSize(4 MB) falla
+//  - la imagen nativa de 960x544 (565) que Adrenaline muestra desde 0x0A400000 mientras el
+//    plugin deja algo distinto de 0 en 0xABCDEF00 (DRAW_NATIVE)
+//  - avisos de lo que en la Vita cae o congela Adrenaline (ver Warn)
+#pragma once
+
+#include <string>
+#include <vector>
+#include <cstdint>
+
+class Path;
+
+namespace Adrenaline {
+
+bool Enabled();
+void Reset();  // al arrancar cada juego
+
+// Rutas ms0:/... de los plugins activos en seplugins/game.txt
+std::vector<std::string> GamePlugins();
+
+// sctrlHENFindFunction de una funcion HLE: stub "jr ra; syscall" propio (0 si no existe)
+uint32_t HleStub(const char *library, uint32_t nid);
+// Si addr es uno de esos stubs, su biblioteca y NID
+bool StubOf(uint32_t addr, std::string *library, uint32_t *nid);
+// sctrlHENPatchSyscall: las importaciones de esa funcion (en cualquier biblioteca que la
+// exporte, como sceGe_user y sceGe_driver) saltan a target
+void AddOverride(const char *library, uint32_t nid, uint32_t target);
+uint32_t ImportOverride(const char *library, uint32_t nid);
+
+// sceKernelInitFileName: el ejecutable con que arranco el juego
+void SetInitFileName(const std::string &filename);
+uint32_t InitFileNameAddr();
+
+// Imagen nativa (DRAW_NATIVE != 0)
+bool NativeActive();
+uint32_t NativeAddress();
+bool SaveNative(const Path &bmp);
+
+// Algo que en la Vita congela o cierra Adrenaline: se registra (una vez por motivo) y, con
+// PPSSPP_ADRENALINE=estricto, se detiene la emulacion
+void Warn(const char *what);
+
+}  // namespace Adrenaline
