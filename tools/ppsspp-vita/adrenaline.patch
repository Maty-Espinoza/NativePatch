+// Adrenaline: una lista con contexto encolada desde un plugin (kernel) congela la Vita (c1-2858-3)
+static void AdrenalineCheckList(MIPSState *mips, u32 optParamAddr) {
+	auto args = PSPPointer<PspGeListArgs>::Create(optParamAddr);
+	if (Adrenaline::Enabled() && args.IsValid() && args->size >= 8 && args->context.ptr != 0 && Memory::IsKernelCodeAddress(mips->r[MIPS_REG_RA]))
+		Adrenaline::Warn("lista del GE con contexto encolada desde un plugin");
+}
+
+// Datos de una lista como los guarda el kernel (SceGeDisplayList): +0x08 estado, +0x14 lista,
+// +0x18 stall. GePatch lee el stall anterior en sceGeListUpdateStallAddr
+static int sceGeGetList(u32 listID, u32 infoAddr, u32 flagAddr) {
+	int id = LIST_ID_MAGIC ^ listID;
+	if (!gpu || !gpu->IsValidListId(id))
+		return hleLogWarning(Log::sceGe, SCE_KERNEL_ERROR_INVALID_ID, "bad list id");
+	const DisplayList *dl = gpu->getList(id);
+	if (Memory::IsValidRange(infoAddr, 0x40)) {
+		Memory::Memset(infoAddr, 0, 0x40);
+		Memory::WriteUnchecked_U16((u16)dl->state, infoAddr + 0x08);
+		Memory::WriteUnchecked_U32(dl->startpc, infoAddr + 0x14);
+		Memory::WriteUnchecked_U32(dl->stall, infoAddr + 0x18);
+	}
+	if (Memory::IsValid4AlignedAddress(flagAddr))
+		Memory::WriteUnchecked_U32(0, flagAddr);
+	return hleLogDebug(Log::sceGe, 0);
+}
