+// Cambia la funcion a la que llegan las syscalls de la funcion en addr (sctrlHENFindFunction).
+// Aqui: las importaciones de los modulos de usuario cargados, y las de los que se carguen despues
+static u32 sctrlHENPatchSyscall(u32 addr, u32 newAddr) {
