// Modulate without alpha test, with no branches: color doubling as a factor (tf.z 1 or 2) and fog (uv.z: 1 none, 0 all of color
// fog). Between nd_fm and nd_ft. tf.y 1 = texture alpha.
float4 main(float3 uv : TEXCOORD0, float4 col : COLOR, uniform sampler2D tex, uniform float4 tf, uniform float4 fog) : COLOR
{
  float4 t = tex2D(tex, uv.xy);
  return float4(lerp(fog.rgb, min(t.rgb * col.rgb * tf.z, 1.0), uv.z), lerp(1.0, t.a, tf.y) * col.a);
}
