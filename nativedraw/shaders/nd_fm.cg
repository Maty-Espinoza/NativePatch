// Fast path of nd_ft for the most common draw: modulate, without alpha test, fog or doubling (tf.y 1 = texture alpha).
float4 main(float3 uv : TEXCOORD0, float4 col : COLOR, uniform sampler2D tex, uniform float4 tf) : COLOR
{
  float4 t = tex2D(tex, uv.xy);
  return float4(t.rgb * col.rgb, lerp(1.0, t.a, tf.y) * col.a);
}
