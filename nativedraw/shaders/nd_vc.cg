// nd_v with the scissor as hardware clip planes. sc: doubled scissor (x0, y0, x1, y1). Each output is the distance to one edge, in
// clip space (x, y are x * w, y * w): the GPU cuts what is negative, with the same formula as the CPU clipping of translator.c.
void main(float4 aPosition, float3 aTexcoord, float4 aColor, uniform float4x4 wvp, uniform float4 sc,
          float4 out vPosition : POSITION, float3 out vTexcoord : TEXCOORD0, float4 out vColor : COLOR, float out vClip[4] : CLP0)
{
  vPosition = mul(aPosition, wvp);
  vTexcoord = aTexcoord;
  vColor = aColor;
  vClip[0] = aPosition.x - sc.x * aPosition.w;
  vClip[1] = aPosition.y - sc.y * aPosition.w;
  vClip[2] = sc.z * aPosition.w - aPosition.x;
  vClip[3] = sc.w * aPosition.w - aPosition.y;
}
