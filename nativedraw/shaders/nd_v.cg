// Translator vertices (translator.c): position in surface pixels times w, with w (clip space: the GPU corrects perspective;
// 1 in 2D), normalized texture coordinates, fog factor in z of TEXCOORD0, and color (u8 x 4). wvp: column-major
// orthographic, like vita2d's.
void main(float4 aPosition, float3 aTexcoord, float4 aColor, uniform float4x4 wvp,
          float4 out vPosition : POSITION, float3 out vTexcoord : TEXCOORD0, float4 out vColor : COLOR)
{
  vPosition = mul(aPosition, wvp);
  vTexcoord = aTexcoord;
  vColor = aColor;
}
