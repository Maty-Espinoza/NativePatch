// 3D vertices of the record as the game wrote them: float weights (none, or up to 8 in aW0 and aW1) and position; 8-bit normal, 8 or
// 16-bit UV and color as integers. What the GE does to them: position and normal are the sum of the bones by their weights; then
// directional and point lights or the lit color with no lights, UV scaled or from the normal (environment map), fog. Uniforms u, by
// rows: 0-3 m, model -> surface clip space; 4 UV scale (xy) and offset (zw); 5 fog factor, dot(position, xyz) + w, 0 to 1; 6, 7 color
// = 6 + 7 * vertex color + diffuse + specular + ambient; 8, 9, 62 diffuse, specular and ambient material, rgb + w * vertex color;
// 10-12 model -> world for the normal (w of 10: 1 UV from the normal, w of 11: 1 8888 color, 0 4444 color in two bytes, w of 12: 1
// no weights, position and normal as they are); 13, 14 directions of the UV from the normal, w its scale; 15-30 four lights:
// direction, or position with w 1 (point light), attenuation (1, 0, 0 for a directional light) and specular power, diffuse color,
// specular color; 31-54 the 8 bones, 3 rows each (zero those with no weight); 55-58 ambient color of each light; 59-61 model ->
// world for the position.
// NB bones (8) and NL lights (4) are what the loops go through: shaders/build.sh also makes lighter variants with fewer, for draws
// whose other bones are zero and other lights off, which add nothing; translator.c puts the lights on first.
#ifndef NB
#define NB 8
#endif
#ifndef NL
#define NL 4
#endif
void main(float4 aW0, float4 aW1, float3 aPosition, float3 aNormal, float2 aTexcoord, float4 aColor, uniform float4 u[63],
          float4 out vPosition : POSITION, float3 out vTexcoord : TEXCOORD0, float4 out vColor : COLOR)
{
  float4 x = float4(aPosition, 1), n = float4(aNormal, 0);
  float3 s = u[12].w * aPosition, sn = u[12].w * aNormal;
  for (int b = 0; b < (NB < 4 ? NB : 4); b++) {
    float4 r0 = u[31 + b * 3], r1 = u[32 + b * 3], r2 = u[33 + b * 3];
    s += aW0[b] * float3(dot(x, r0), dot(x, r1), dot(x, r2));
    sn += aW0[b] * float3(dot(n, r0), dot(n, r1), dot(n, r2));
  }
  for (int b = 0; b < NB - 4; b++) {
    float4 r0 = u[43 + b * 3], r1 = u[44 + b * 3], r2 = u[45 + b * 3];
    s += aW1[b] * float3(dot(x, r0), dot(x, r1), dot(x, r2));
    sn += aW1[b] * float3(dot(n, r0), dot(n, r1), dot(n, r2));
  }
  float3 w = float3(dot(sn, u[10].xyz), dot(sn, u[11].xyz), dot(sn, u[12].xyz));
  w *= rsqrt(max(dot(w, w), 1e-30));
  float2 h = floor(aColor.xy / 16), l = aColor.xy - h * 16;
  float4 c = u[11].w > 0 ? aColor / 255 : float4(l.x, h.x, l.y, h.y) / 15;
  float4 sw = float4(s, 1);
  float3 wp = float3(dot(sw, u[59]), dot(sw, u[60]), dot(sw, u[61])), d = 0, p = 0, a = 0;
  for (int i = 0; i < NL; i++) {  // (light direction L, attenuation k, half vector L + (0, 0, 1))
    float4 lp = u[15 + i * 4], at = u[16 + i * 4];
    float3 L = lp.xyz - lp.w * wp;
    float r = max(dot(L, L), 1e-30), den = at.x + at.y * sqrt(r) + at.z * r, k = den > 0 ? min(1 / den, 1) : 0;
    L *= rsqrt(r);
    float3 hv = L + float3(0, 0, 1);
    float nl = dot(w, L), sp = dot(w, hv) * rsqrt(max(dot(hv, hv), 1e-30));
    d += k * max(nl, 0) * u[17 + i * 4].rgb;
    p += k * (nl >= 0 && sp > 0 ? pow(sp, at.w) : 0) * u[18 + i * 4].rgb;
    a += k * u[55 + i].rgb;
  }
  vPosition = s.x * u[0] + s.y * u[1] + s.z * u[2] + u[3];
  float2 e = (float2(dot(w, u[13].xyz), dot(w, u[14].xyz)) + 1) * 0.5 * float2(u[13].w, u[14].w);
  vTexcoord = float3(u[10].w > 0 ? e : aTexcoord * u[4].xy + u[4].zw, saturate(dot(s, u[5].xyz) + u[5].w));
  vColor = saturate(u[6] + u[7] * c + float4(d * (u[8].rgb + u[8].w * c.rgb) + p * (u[9].rgb + u[9].w * c.rgb) + a * (u[62].rgb + u[62].w * c.rgb), 0));
}
