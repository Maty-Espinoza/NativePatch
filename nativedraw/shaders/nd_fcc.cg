// nd_fc with the scissor sc (doubled, x0, y0, x1, y1): what falls outside is discarded. Translator fragments without texture: the vertex color, with fog and alpha test (like nd_ft).
float4 main(float3 uv : TEXCOORD0, float4 col : COLOR, float2 p : WPOS, uniform float4 sc, uniform float4 at, uniform float4 fog) : COLOR
{
  if (p.x < sc.x || p.y < sc.y || p.x >= sc.z || p.y >= sc.w) discard;
  float a = floor(col.a * 255.0 + 0.5);
  if (at.x < 0.5) discard;
  else if (at.x < 1.5) {}
  else if (at.x < 2.5) { if (a != at.y) discard; }
  else if (at.x < 3.5) { if (a == at.y) discard; }
  else if (at.x < 4.5) { if (a >= at.y) discard; }
  else if (at.x < 5.5) { if (a > at.y) discard; }
  else if (at.x < 6.5) { if (a <= at.y) discard; }
  else { if (a < at.y) discard; }
  return float4(lerp(fog.rgb, col.rgb, uv.z), at.z > 0.5 ? min(col.a * 2.0, 1.0) : col.a);
}
