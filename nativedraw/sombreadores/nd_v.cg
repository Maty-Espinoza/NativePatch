// Vertices del traductor: posicion en pixeles de la superficie, coordenadas de textura normalizadas y color (u8 x 4).
void main(float3 aPosition, float2 aTexcoord, float4 aColor, uniform float4x4 wvp,
          float4 out vPosition : POSITION, float2 out vTexcoord : TEXCOORD0, float4 out vColor : COLOR)
{
  vPosition = mul(float4(aPosition, 1.f), wvp);
  vTexcoord = aTexcoord;
  vColor = aColor;
}
