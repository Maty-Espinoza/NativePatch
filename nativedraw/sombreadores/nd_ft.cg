// Con textura: funcion de textura del GE (tf.x 0 modular, 1 reemplazar; tf.y 1 = alfa de la textura (TCC); tf.z 1 =
// color al doble) y alfa test (at.x funcion del GE 0-7, at.y referencia 0-255).
float4 main(float2 uv : TEXCOORD0, float4 col : COLOR, uniform sampler2D tex, uniform float4 tf, uniform float4 at) : COLOR
{
  float4 t = tex2D(tex, uv);
  float4 c;
  if (tf.x > 0.5) c = float4(t.rgb, tf.y > 0.5 ? t.a : col.a);
  else c = float4(t.rgb * col.rgb, tf.y > 0.5 ? t.a * col.a : col.a);
  if (tf.z > 0.5) c.rgb = min(c.rgb * 2.0, 1.0);
  float a = floor(c.a * 255.0 + 0.5);
  if (at.x < 0.5) discard;
  else if (at.x < 1.5) {}
  else if (at.x < 2.5) { if (a != at.y) discard; }
  else if (at.x < 3.5) { if (a == at.y) discard; }
  else if (at.x < 4.5) { if (a >= at.y) discard; }
  else if (at.x < 5.5) { if (a > at.y) discard; }
  else if (at.x < 6.5) { if (a <= at.y) discard; }
  else { if (a < at.y) discard; }
  return c;
}
